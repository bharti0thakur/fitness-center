<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9"
    tools:context=".StretchingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_to_page_1"
            android:textSize="24sp"
            android:textColor="#1B263B"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Video Grid -->
        <GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="4"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true"
            android:layout_marginBottom="16dp">

            <!-- 8 Video Thumbnail ImageViews -->
            <ImageView
                android:id="@+id/video1"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/yoga11"
                android:contentDescription="@string/video_1" />

            <ImageView
                android:id="@+id/video2"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/yoga"
                android:contentDescription="@string/video_2" />

            <ImageView
                android:id="@+id/video3"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/yoga2"
                android:contentDescription="@string/video_3" />

            <ImageView
                android:id="@+id/video4"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:contentDescription="@string/video_4"
                android:scaleType="centerCrop"
                android:src="@drawable/yoga33"
                tools:ignore="ImageContrastCheck" />

            <ImageView
                android:id="@+id/video5"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/yoga333"
                android:contentDescription="@string/video_5" />

            <ImageView
                android:id="@+id/video6"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/yoga44"
                android:contentDescription="@string/video_6" />

            <ImageView
                android:id="@+id/video7"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/yoga55"
                android:contentDescription="@string/video_7" />

            <ImageView
                android:id="@+id/video8"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:scaleType="centerCrop"
                android:src="@drawable/yoga22"
                android:contentDescription="@string/video_8" />

        </GridLayout>
    </LinearLayout>
</ScrollView>
